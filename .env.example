# このファイルをコピーして .env.local を作る（.env.local は Git に入れない）。
# 本番の値は、Vercel の Project Settings → Environment Variables に登録する。

# ── サイトの URL ────────────────────────────────────────────
# 本番ドメイン（末尾の / なし）。例：https://www.example.jp
# 空のあいだは、全ページが noindex・sitemap は空・robots は Disallow になる（プレビューが検索に載るのを防ぐため）。
# 本番ドメインが決まったら、lib/site.ts の productionUrl に書けば、Vercel の本番環境では自動で使われる。
NEXT_PUBLIC_SITE_URL=

# ── お問い合わせフォーム（Resend）──────────────────────────────
# RESEND_API_KEY と CONTACT_TO_EMAIL の2つがそろうと、/contact にフォームが出る。
# そろうまでは、本番ではフォームを出さず、電話・LINE・Instagram の案内だけを出す（フォームへのボタンや案内文も出ない）。
# Resend では、ドメイン yokohama-sogo-jusetsu.com を認証済み（2026-10-09）。API キーは Resend の「API keys」で作る。
RESEND_API_KEY=
# 受け取るメールアドレス（会社の代表アドレス。カンマ区切りで複数可）
CONTACT_TO_EMAIL=
# 差出人（任意）。空のときは、本番ドメインの noreply@ から送る（例：横浜総合住設 お問い合わせフォーム <noreply@yokohama-sogo-jusetsu.com>）。
# 変えたいときだけ書く。Resend で認証したドメインのアドレスにすること。
CONTACT_FROM_EMAIL=
# "1" にすると、メールアドレスを入力したお客様にも受付の控えを送る（差出人のドメイン認証が必要）
CONTACT_AUTOREPLY=

# ── コラムの自動投稿（GitHub Actions が使う。Vercel には不要）─────────
# GitHub のリポジトリ → Settings → Secrets and variables → Actions → Secrets に登録する。
ANTHROPIC_API_KEY=
# 以下は省略できる（GitHub の Variables に登録すると既定を変えられる）
# 書くモデル。既定は claude-opus-5-5。費用を抑えるなら claude-sonnet-5-5
ANTHROPIC_MODEL=
# 読み直す（事実確認をする）モデル。既定は claude-opus-5-5
ANTHROPIC_REVIEW_MODEL=
# "off" にすると、モデルが応答を断ったときに代替モデルへ切り替える機能を使わない
ANTHROPIC_FALLBACKS=

# ── 検索エンジンの所有確認（任意）──────────────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
